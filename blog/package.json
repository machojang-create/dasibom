{
  "name": "dasibom-blog",
  "private": true,
  "type": "module",
  "description": "다시봄라이프 네이버 블로그 자동 발행 파이프라인",
  "scripts": {
    "login": "node login_naver.mjs",
    "status": "node run.mjs --status",
    "draft": "node run.mjs --no-publish",
    "post": "node run.mjs",
    "post:now": "node run.mjs --now",
    "expand": "node expand_queue.mjs --auto",
    "lint": "node lint_post.mjs --all",
    "cats": "node run.mjs --categories",
    "figures": "node gen_figures.mjs --all",
    "illust": "node gen_illust.mjs --all",
    "images": "node gen_blog_assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "playwright": "^1.50.0",
    "sharp": "^0.35.3"
  }
